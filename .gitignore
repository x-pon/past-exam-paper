.DS_Store
.idea/
.vscode/
*.swp
*.tmp

__pycache__/
*.pyc
.python-version
.venv/

# Keep large binaries out by default (override consciously)
*.pdf
*.png
*.jpg
*.jpeg
*.webp
*.mp3
*.wav

# Allow exam assets under papers/ to be tracked
!papers/**/*.pdf
!papers/**/*.png
!papers/**/*.jpg
!papers/**/*.jpeg
!papers/**/*.webp
!papers/**/*.mp3
!papers/**/*.wav

